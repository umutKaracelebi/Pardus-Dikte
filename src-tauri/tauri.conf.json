{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "pardus-dikte",
  "version": "1.0.0",
  "identifier": "com.inoturk.pardus-dikte",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Pardus Dikte",
        "width": 900,
        "height": 700
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "publisher": "İnoTürk",
    "homepage": "https://inoturk.netlify.app/",
    "license": "GPL-3.0",
    "licenseFile": "../LICENSE",
    "shortDescription": "Yapay Zeka Destekli Sesli Yazı Asistanı",
    "longDescription": "Pardus Dikte, OpenAI Whisper yapay zeka modelleri kullanarak konuşmayı gerçek zamanlı olarak metne dönüştüren, tamamen çevrimdışı çalışan bir sesli yazı asistanıdır. İnoTürk tarafından 2026 Teknofest Pardus Yarışması için geliştirilmiştir.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "stt_engine.py",
      "overlay.py",
      "paste_helper.py",
      "requirements.txt"
    ],
    "linux": {
      "deb": {
        "depends": ["python3", "python3-venv", "python3-pip", "python3-gi", "python3-gi-cairo", "gir1.2-gtk-3.0", "libwebkit2gtk-4.1-0", "libayatana-appindicator3-1", "xclip"],
        "section": "utils",
        "desktopTemplate": "pardus-dikte.desktop",
        "files": {
          "/usr/share/doc/pardus-dikte/copyright": "copyright"
        }
      }
    }
  }
}
